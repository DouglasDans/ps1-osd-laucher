[Unit]
Description=PS1 OSD Laucher - Auto Update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=douglasdans
# Só age se o pull trouxe commit novo — incondicional mataria a intro
# em todo boot com rede. Recopia os units pro /etc porque install.sh só
# roda manualmente: sem isso, um fix no próprio .service fica preso.
ExecStart=/bin/bash -c 'cd /home/douglasdans/ps1-osd-laucher && before=$(git rev-parse HEAD) && git pull && after=$(git rev-parse HEAD) && if [ "$before" != "$after" ]; then sudo cp /home/douglasdans/ps1-osd-laucher/systemd/ps1-osd-laucher.service /etc/systemd/system/ps1-osd-laucher.service && sudo cp /home/douglasdans/ps1-osd-laucher/systemd/ps1-osd-update.service /etc/systemd/system/ps1-osd-update.service && sudo systemctl daemon-reload && sudo systemctl restart ps1-osd-laucher; fi'

[Install]
WantedBy=multi-user.target
